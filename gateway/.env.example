# ============================================================================
# SEAI Shopify Gateway — environment template
# ----------------------------------------------------------------------------
# This file contains VARIABLE NAMES ONLY. It must never contain real
# credentials. Copy to `.env` for local development; `.env` is git-ignored.
# Never commit secrets. Production values come from the platform secrets store.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Shopify ----------------------------------------------------------------
# Public app client id (from Shopify Partners "Client credentials"). The
# client id is public; the SECRET below is not.
SHOPIFY_API_KEY=replace-with-shopify-client-id
SHOPIFY_API_SECRET=replace-with-shopify-client-secret
# Comma-separated install scopes (must match the toml file at repo root).
SHOPIFY_API_SCOPES=read_products,write_products,read_orders
# Pinned to match the SEAI backend contract. Do NOT change independently.
SHOPIFY_API_VERSION=2025-07
# Public HTTPS base URL of the deployed gateway (set after deployment).
SHOPIFY_APP_URL=https://replace-with-gateway-production-host

# --- SEAI platform (source of truth) ---------------------------------------
SEAI_BASE_URL=https://www.seai.store
SEAI_API_BASE_URL=https://replace-with-seai-backend-api
SEAI_WEBHOOK_SECRET=replace-with-signed-seai-shared-secret

# --- Security: at-rest encryption & signing keys (32-byte, base64) ----------
SESSION_STORAGE_KEY=replace-with-32-byte-random-key
GATEWAY_TOKEN_SIGNING_KEY=replace-with-32-byte-random-key
# Shared HMAC secret for minting/verifying one-time SEAI iframe tickets.
# MUST be identical to SEAI_GATEWAY_SECRET in the SEAI platform (.env).
SEAI_GATEWAY_SECRET=replace-with-32-byte-random-key

# --- Storage -----------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/seai_gateway
REDIS_URL=

# --- Telemetry ---------------------------------------------------------------
SENTRY_DSN=

# --- Rate limiting / token TTLs ----------------------------------------------
# Per-shop GraphQL proxy budget (requests per minute).
SHOPIFY_PROXY_RATE_LIMIT_PER_MINUTE=240
# Short-lived gateway token TTL for SEAI-backend proxy auth (seconds).
GATEWAY_TOKEN_TTL_SECONDS=300
# Short-lived SEAI link claim TTL (seconds).
SEAI_LINK_TTL_SECONDS=300
# Short-lived SEAI iframe ticket TTL (seconds).
SEAI_TICKET_TTL_SECONDS=300

# --- Browser surface ----------------------------------------------------------
# Comma-separated origins allowed for CORS (server-to-server needs none).
CORS_ALLOWED_ORIGINS=