{
  "name": "seai-shopify-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "SEAI Shopify integration gateway — owns Shopify OAuth sessions, encrypted store-token storage, the Admin GraphQL proxy and webhooks for the existing SEAI platform (the source of truth).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@shopify/shopify-api": "^11.10.0",
    "dotenv": "^17.0.0",
    "express": "^4.21.2",
    "pg": "^8.11.0",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}