    "db:migrate": "tsx src/db/migrate.ts",
    "email:preview": "tsx scripts/preview-emails.ts",
    "email:audit": "tsx scripts/audit-emails.ts",
    "shopify:auth:verify": "tsx src/shopify/verify.ts",
    "dev:vite": "vite",
    "build:public": "vite build && node scripts/inline-page-css.mjs"
  },
  "dependencies": {
    "@shopify/shopify-api": "^11.7.0",
