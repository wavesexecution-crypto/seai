    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
