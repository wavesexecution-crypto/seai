# SEAI — the ONLY secrets you ever enter. Get keys at https://ollama.com/settings/keys
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
OLLAMA_API_KEY_4=
OLLAMA_API_KEY_5=
OLLAMA_API_KEY_6=

# --- Everything below is optional. Defaults work out of the box. ---
# Shopify OAuth (from your Shopify Partner dashboard app; user never pastes tokens):
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# Production canonical URL:
# SHOPIFY_APP_URL=https://seai.store
# Local development:
# SHOPIFY_APP_URL=http://localhost:3000
# SHOPIFY_API_VERSION=2025-07
# Who SEAI addresses in greetings (display name only, never sent to Shopify):
# OPERATOR_NAME=
# Primary reasoning model (must match a name from Ollama discovery; unset = auto-strongest):
# AI_PRIMARY_MODEL=

# --- Experiential gateway (optional) ---
# Routes the model claude-fable-5.1 through api.experientiallabs.ai (OpenAI
# Chat Completions compatible) instead of calling the provider directly.
# Create the key under Settings -> API keys, then export it:
#   export EXPLABS_API_KEY=xpl_...
# EXPLABS_API_KEY=
# Optional base URL override:
# EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# Database (REQUIRED in production on Vercel — local disk is ephemeral there):
# DATABASE_URL=postgresql://user:password@host:5432/seai
# Token encryption at rest (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"):
# SEAI_ENCRYPTION_KEY=
# Autonomy: OBSERVE | ASSIST | EXECUTE_SAFE (default) | AUTONOMOUS
# AUTONOMY_LEVEL=EXECUTE_SAFE
# AGENT_MAX_ITERATIONS=12
# Background scheduler: on | off (default off on Vercel — use Vercel Cron instead)
# SEAI_SCHEDULER=
# Local overrides for embedded state (dev/test only; ephemeral on Vercel):
# SEAI_DATA_DIR=
# SEAI_BRAIN_DIR=
# PORT=3000
# --- Transactional client email (SMTP) ---
# Sender identity for every customer email. Gmail requires the verified sender
# to match the authenticated SMTP account.
# MAIL_FROM=SEAI <workwithseai@gmail.com>
# MAIL_FROM_NAME=SEAI
# Gmail SMTP: host smtp.gmail.com, port 587, secure false, full auth. Use a
# Google App Password (not the account password) when 2FA is on.
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=workwithseai@gmail.com
# MAIL_SMTP_PASS=
# Hosts used to build links inside emails. Production values only: a localhost
# or preview host is rejected at render time unless the dev escape hatch below
# is set. Never set the escape hatch in production.
# APP_URL=https://dash.seai.store
# PUBLIC_URL=https://seai.store
# Logo shown in the email header. Must be an absolute public https URL (Gmail
# proxies remote images). Unset = text wordmark only.
# SEAI_MAIL_LOGO_URL=https://seai.store/assets/brand/seai-mark.png
# Address shown as the support contact in the footer:
# SEAI_SUPPORT_EMAIL=workwithseai@gmail.com
# Kill switch for the whole client email pipeline. Set false during an incident
# or a QA run; delivery history is unaffected.
# SEAI_MAIL_EVENTS_ENABLED=true
# Sends every preview and lifecycle email to this mailbox instead of the real
# recipient. Unset in production unless you deliberately want that.
# SEAI_MAIL_QA_RECIPIENT=
# Shared secret for authoritative server-to-server events (payment service,
# operations webhooks) posted to /api/internal/mail/events. Unset = intake is
# disabled and returns 503. Requests must carry:
#   x-seai-event-timestamp: <epoch ms>
#   x-seai-event-signature: <hex HMAC-SHA256 of "<timestamp>.<raw body>">
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SEAI_EVENTS_SHARED_SECRET=
# Local rendering escape hatch that allows localhost/preview hosts in links.
# Never enable in production.
# SEAI_MAIL_ALLOW_DEV_URLS=false

# Shopify gateway HMAC secret (Phase 6 — shared with the SEAI Shopify Gateway's
# GATEWAY_TOKEN_SIGNING_KEY for one-time ticket verification). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SEAI_GATEWAY_SECRET=

# seai.storage control plane (server-side only — never expose to browsers).
# Full contract: seai.storage docs/INTEGRATION_CONTRACT_FINAL.md
# STORAGE_SERVICE_URL=https://storage.seai.store
# STORAGE_SERVICE_NAME=cdf
# STORAGE_SERVICE_KEY=
# STORAGE_JWT_SECRET= (min 32 random chars, shared with seai.storage)
# STORAGE_TOKEN_TTL_SEC=300
# STORAGE_PROXY_MAX_BYTES=10485760
