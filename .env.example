# SEAI — the ONLY secrets you ever enter. Get keys at https://ollama.com/settings/keys
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
OLLAMA_API_KEY_4=
OLLAMA_API_KEY_5=
OLLAMA_API_KEY_6=

# --- Everything below is optional. Defaults work out of the box. ---
# Shopify OAuth (from your Shopify Partner dashboard app; user never pastes tokens):
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# Production canonical URL:
# SHOPIFY_APP_URL=https://seai.store
# Local development:
# SHOPIFY_APP_URL=http://localhost:3000
# SHOPIFY_API_VERSION=2025-07
# Who SEAI addresses in greetings (display name only, never sent to Shopify):
# OPERATOR_NAME=
# Primary reasoning model (must match a name from Ollama discovery; unset = auto-strongest):
# AI_PRIMARY_MODEL=

# --- Experiential gateway (optional) ---
# Routes the model claude-fable-5.1 through api.experientiallabs.ai (OpenAI
# Chat Completions compatible) instead of calling the provider directly.
# Create the key under Settings -> API keys, then export it:
#   export EXPLABS_API_KEY=xpl_...
# EXPLABS_API_KEY=
# Optional base URL override:
# EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# Database (REQUIRED in production on Vercel — local disk is ephemeral there):
# DATABASE_URL=postgresql://user:password@host:5432/seai
# Token encryption at rest (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"):
# SEAI_ENCRYPTION_KEY=
# Autonomy: OBSERVE | ASSIST | EXECUTE_SAFE (default) | AUTONOMOUS
# AUTONOMY_LEVEL=EXECUTE_SAFE
# AGENT_MAX_ITERATIONS=12
# Background scheduler: on | off (default off on Vercel — use Vercel Cron instead)
# SEAI_SCHEDULER=
# Local overrides for embedded state (dev/test only; ephemeral on Vercel):
# SEAI_DATA_DIR=
# SEAI_BRAIN_DIR=
# PORT=3000
# Shopify gateway HMAC secret (Phase 6 — shared with the SEAI Shopify Gateway's
# GATEWAY_TOKEN_SIGNING_KEY for one-time ticket verification). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SEAI_GATEWAY_SECRET=
