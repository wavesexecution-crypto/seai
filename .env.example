# seai.public environment
#
# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# ---------------------------------------------------------------------------
# Payments (server-side only)
# ---------------------------------------------------------------------------
# The browser never holds any of these. The same-origin functions in
# api/payment/*.ts read them from the environment and call seai.payments
# with `Authorization: Bearer <key>`. Nothing in public/ may reference them.
#
# SEAI_PUBLIC_SERVICE_KEY is the name seai.payments maps to the `seai.public`
# service identity (src/middleware/auth.ts). SEAPI_PUBLIC_SERVICE_KEY is
# accepted as a legacy alias; configure the documented name.
SEAI_PUBLIC_SERVICE_KEY=
# SEAPI_PUBLIC_SERVICE_KEY=

# seai.payments base URL. Defaults to https://payments.seai.store/api/v1
SEAI_PAYMENT_API_BASE=

# ---------------------------------------------------------------------------
# Storage (server-side only)
# ---------------------------------------------------------------------------
# Used by the intake upload proxy (api/storage/** and server/storage-proxy.js).
# The browser only ever receives a short-lived signed upload URL and a file ID.
# Intakes are anonymous and pre-payment, so files are scoped to a provisional
# tenant `intake:<session-uuid>` until CDF adopts them after signup.
SEAI_STORAGE_API_BASE=
SEAI_STORAGE_SERVICE_NAME=seai-public
SEAI_STORAGE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Local dev
# ---------------------------------------------------------------------------
# Origin allowed by the Express proxies' CORS. Production traffic is
# same-origin on Vercel, so this only matters for `npm run dev`.
ALLOWED_ORIGIN=https://seai.store

# ---------------------------------------------------------------------------
# Demo imagery pipeline (local only, never used by the build)
# ---------------------------------------------------------------------------
# Pexels API key - https://www.pexels.com/api/
# Free. Powers the photography pipeline that self-hosts demo imagery into
# public/assets/demos/<business>/. The key is only ever read from the local
# environment; it is never written into the repo, the build, or the demos.
PEXELS_API_KEY=
